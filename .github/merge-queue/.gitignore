# Hypothesis database — track .gitkeep to establish the examples dir; ignore internal DB files
# (Hypothesis saves counterexamples to .hypothesis/examples/ — the .gitkeep ensures the
# directory exists in the repo; actual counterexample files are generated at test-run time)
.hypothesis/constants/
.hypothesis/unicode_data/
.hypothesis/*.json
.hypothesis/examples/*/

# Python build artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Virtual environments
.venv/
venv/

# uv lockfile artefacts (committed separately if uv is adopted)
# uv.lock is intentionally excluded from gitignore — commit it when generated

# Per-cycle artifact emitted by rocm_mq.cmd_process.process_cycle (the dual
# sink that ships alongside $GITHUB_STEP_SUMMARY — RESEARCH.md Area #11).
# Uploaded by .github/workflows/mq-processor.yml via actions/upload-artifact
# every cycle; locally regenerated by every `pytest` run that exercises
# process_cycle without setting MQ_CYCLE_SUMMARY_PATH. Never committed.
cycle-summary.md
