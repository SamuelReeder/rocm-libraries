# Hypothesis database — track .gitkeep to establish the examples dir; ignore internal DB files
# (Hypothesis saves counterexamples to .hypothesis/examples/ — the .gitkeep ensures the
# directory exists in the repo; actual counterexample files are generated at test-run time)
.hypothesis/constants/
.hypothesis/unicode_data/
.hypothesis/*.json
.hypothesis/examples/*/

# Python build artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Virtual environments
.venv/
venv/

# uv lockfile artefacts (committed separately if uv is adopted)
# uv.lock is intentionally excluded from gitignore — commit it when generated
